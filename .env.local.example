# Public URL of the deployed site, used for metadata/OG/sitemap. Optional:
# on Vercel this is auto-detected from the deployment (see src/lib/site.ts);
# only set this if you're using a custom domain and want it reflected there.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Not used yet; required once the contact form is wired to Resend.
# See the TODO in src/app/api/contact/route.ts.
RESEND_API_KEY=
